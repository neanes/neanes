{
  "globs": [
    "*.md",
    "!CLAUDE.md",
    ".github/**/*.md",
    "docs/**/*.md",
    "notes/**/*.md",
  ],
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true,
    },
    "MD033": {
      "allowed_elements": [
        "audio",
        "code",
        "details",
        "div",
        "Downloads",
        "figcaption",
        "figure",
        "h3",
        "img",
        "kbd",
        "PhAlignRight",
        "PhArrowClockwise",
        "PhArrowCounterClockwise",
        "PhClipboardText",
        "PhCopy",
        "PhCrosshair",
        "PhFile",
        "PhMagnifyingGlass",
        "PhParagraph",
        "PhPlus",
        "PhScissors",
        "PhTextAlignCenter",
        "PhTextTSlash",
        "PhTrash",
        "script",
        "source",
        "span",
        "strong",
        "style",
        "summary",
        "svg",
      ],
    },
  },
}
